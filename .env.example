# Public hostname that points at the VPS; Traefik gets the HTTPS certificate for it.
DOMAIN=davincicommit.tech
# Short git sha shown by /api/health. Set when building: GIT_SHA=$(git rev-parse --short HEAD)
GIT_SHA=dev
AI_ROUTER_API_KEY=
AI_ROUTER_BASE_URL=
AI_ROUTER_MODEL=
# Optional, only if Bluesky search needs a login (step 4.1)
BSKY_HANDLE=
BSKY_APP_PASSWORD=
# Preferred technique detector (six techniques, measured). If unset or failing, the router above is used.
ANTHROPIC_API_KEY=
# Optional hard stop (worst-case dollars, assumed rates) and a file to persist the token count
LLM_BUDGET_USD=15
LLM_LEDGER_PATH=
