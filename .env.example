# Public hostname that points at the VPS; Caddy gets the HTTPS certificate for it.
DOMAIN=example.com
# Short git sha shown by /api/health. Set when building: GIT_SHA=$(git rev-parse --short HEAD)
GIT_SHA=dev
AI_ROUTER_API_KEY=
AI_ROUTER_BASE_URL=
AI_ROUTER_MODEL=
# Optional, only if Bluesky search needs a login (step 4.1)
BSKY_HANDLE=
BSKY_APP_PASSWORD=
