{
  "manifest_version": 3,
  "name": "Decode the Noise",
  "version": "0.1.0",
  "description": "Shows persuasion techniques, bot-likeness and copies for the Bluesky post or YouTube video in this tab.",
  "action": { "default_title": "Decode this tab" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "tabs", "scripting", "contextMenus", "storage"],
  "host_permissions": ["https://davincicommit.tech/*", "https://www.youtube.com/*"]
}
